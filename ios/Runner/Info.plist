<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Gupshupgo</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>gupshupgo</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- Lets a silent data push start the app so it can answer an E2EE resend
	     request without the user opening it (see resend_wakeup.dart). Apple
	     throttles these and never wakes an app the user force-quit from the app
	     switcher, so this is best-effort on iOS in a way it isn't on Android. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>NSContactsUsageDescription</key>
	<string>GupShupGo needs access to your contacts to match existing friends on GupShupGo.</string>
	<key>NSCameraUsageDescription</key>
	<string>GupShupGo needs camera access to scan profile QR codes and for video calls.</string>
	<!-- AdMob. GADApplicationIdentifier is not optional: with google_mobile_ads
	     linked, the SDK raises at launch if this key is absent or malformed, so
	     the iOS build would crash on start even though ads are Android-first.
	     This is the app ID (…~2552239193), not an ad unit ID. -->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-8214980075451384~2552239193</string>
	<!-- Shown in Apple's App Tracking Transparency prompt. Required before the
	     ads SDK may read the IDFA; without ATT consent, iOS ads serve
	     non-personalised. -->
	<key>NSUserTrackingUsageDescription</key>
	<string>GupShupGo uses this to show you more relevant ads. Your messages are end-to-end encrypted and are never used for advertising.</string>
</dict>
</plist>
