{
  "hosting": {
    "public": "web/profile-links",
    "ignore": ["README.md"],
    "redirects": [
      {
        "source": "/u/**",
        "destination": "https://play.google.com/store/apps/details?id=com.gupshupgo.app",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Cache-Control", "value": "public, max-age=3600"}
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}
