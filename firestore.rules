rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==================== USERS ====================
    match /users/{userId} {
      // Anyone authenticated can read user profiles (for contacts list)
      allow read: if request.auth != null;
      
      // Helper functions to prevent client from writing subscription fields
      // (only server-side Cloud Functions via Admin SDK are allowed to set these)
      function doesNotCreateSubscriptions() {
        return !request.resource.data.keys().hasAny([
          'subscriptionPlan',
          'subscriptionExpiresAt',
          'subscriptionProductId',
          'subscriptionVerifiedAt',
          'subscriptionPurchaseToken'
        ]);
      }

      function doesNotModifySubscriptions() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'subscriptionPlan',
          'subscriptionExpiresAt',
          'subscriptionProductId',
          'subscriptionVerifiedAt',
          'subscriptionPurchaseToken'
        ]);
      }

      // Users can only create/update their own profile
      allow create: if request.auth != null && request.auth.uid == userId && doesNotCreateSubscriptions();
      allow update: if request.auth != null && request.auth.uid == userId && doesNotModifySubscriptions();
      
      // Prevent users from deleting profiles
      allow delete: if false;

      // Each signed-in app install stores its own FCM token here. This avoids
      // one device overwriting another and lets Cloud Functions clean up only
      // the stale device token that Firebase rejects.
      //
      // E2EE: this same path also stores the Signal PreKeyBundle (public).
      //   - keyBundle must be readable by ANY authenticated user (otherwise
      //     peers can't initiate a session).
      //   - Only the owner can write/update their own bundle.
      match /devices/{deviceId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;

        // One-time prekeys: readable only by the owner (for the
        // replenishOneTimePreKeysIfLow count check), writable only by the
        // owner. Peers never read these directly — the consumeOneTimePreKey
        // Cloud Function uses the Admin SDK and bypasses rules entirely.
        match /oneTimePreKeys/{preKeyId} {
          allow read: if request.auth != null
            && request.auth.uid == userId;
          allow create, update, delete: if request.auth != null
            && request.auth.uid == userId;
        }
      }

      // E2EE: vault key derivation metadata (Argon2id salt + verifier).
      // Required by VaultCipher.bootstrap on every cold start to decide
      // setup-vs-unlock. Document is owner-only — without it the PIN
      // prompt never appears and the rest of the vault is unreadable.
      match /vaultMeta/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Cross-install message vault: AES-256-GCM ciphertext of decrypted
      // payloads, keyed off the user's vault PIN. Owner-only.
      match /msgVault/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Cross-install status vault: AES-256-GCM ciphertext of decrypted
      // text statuses and AES content keys for media statuses. Owner-only.
      match /statusVault/{statusItemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Friends connection subcollection.
      match /friends/{friendId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.uid == friendId);
      }
    }
    
    // ==================== CHAT ROOMS ====================
    match /chatRooms/{chatRoomId} {
      // Helper function to check if user is participant
      function isParticipant() {
        return resource.data.participants != null 
          && request.auth.uid in resource.data.participants;
      }
      
      function willBeParticipant() {
        return request.resource.data.participants != null
          && request.auth.uid in request.resource.data.participants;
      }
      
      // Helper to check if user ID is in the chatRoomId (fallback for legacy data)
      function isUserInChatRoomId() {
        return chatRoomId.matches('.*' + request.auth.uid + '.*');
      }

      // ---------- Streak (bond) hardening ----------
      // Legacy streak fields still written by old clients on the send path.
      // The authoritative state lives in chatRooms/{id}/streak/state and is
      // written only by Cloud Functions (Admin SDK bypasses these rules).
      function streakLegacyFields() {
        return ['streakCount', 'previousStreakCount', 'lastInteractionDate',
                'lastSentAt', 'streakBrokenAt'];
      }

      function touchesStreak() {
        return request.resource.data.diff(resource.data)
                 .affectedKeys().hasAny(streakLegacyFields());
      }

      // Only the caller's own lastSentAt entry may change, and only to ~now.
      function ownLastSentAtIsFresh() {
        let before = resource.data.get('lastSentAt', {});
        let after = request.resource.data.get('lastSentAt', {});
        let mine = after.get(request.auth.uid, null);
        return after.diff(before).affectedKeys().hasOnly([request.auth.uid])
          && mine is timestamp
          && mine >= request.time - duration.value(5, 'm')
          && mine <= request.time + duration.value(5, 'm');
      }

      // PHASE 1 (dual-write window): legacy streak writes from old clients are
      // tolerated but clamped, so an outdated client cannot forge a streak.
      // A hard deny here would reject the entire message batch those clients
      // send and break message delivery, hence the clamp instead of a deny.
      function legacyStreakWriteIsHarmless() {
        return
          // previousStreakCount is server-only.
          !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['previousStreakCount'])
          // streakBrokenAt may only be cleared, never stamped by a client.
          && (!request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['streakBrokenAt'])
              || request.resource.data.get('streakBrokenAt', null) == null)
          // streakCount may only stay put or advance by exactly one.
          && (!request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['streakCount'])
              || (request.resource.data.get('streakCount', -1) is int
                  && request.resource.data.get('streakCount', -1)
                       >= resource.data.get('streakCount', 0)
                  && request.resource.data.get('streakCount', -1)
                       <= resource.data.get('streakCount', 0) + 1))
          // lastInteractionDate must be within +/- 5 minutes of server time.
          && (!request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['lastInteractionDate'])
              || (request.resource.data.get('lastInteractionDate', null) is timestamp
                  && request.resource.data.get('lastInteractionDate', null)
                       >= request.time - duration.value(5, 'm')
                  && request.resource.data.get('lastInteractionDate', null)
                       <= request.time + duration.value(5, 'm')))
          // lastSentAt: own uid only, within +/- 5 minutes of server time.
          && (!request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['lastSentAt'])
              || ownLastSentAtIsFresh());
      }

      // Allow creating chat room if user is a participant
      allow create: if request.auth != null && willBeParticipant();
      
      // Allow reading if user is a participant OR user ID is in chatRoomId (legacy support)
      allow read: if request.auth != null && (isParticipant() || isUserInChatRoomId());
      
      // Allow updating (for last message, unread count, etc.).
      // isUserInChatRoomId() is deliberately NOT accepted here: a modified
      // client could create a room whose id contains its own uid, which is a
      // forgeable write path. Reads keep it for legacy data compatibility.
      allow update: if request.auth != null
        && isParticipant()
        && (!touchesStreak() || legacyStreakWriteIsHarmless());

      // PHASE 2 (task 10.4, after minimum-version enforcement): hard deny any
      // client write to the legacy streak fields. Replaces the clamp above.
      // allow update: if request.auth != null && isParticipant() && !touchesStreak();

      // Prevent deletion of chat rooms (or allow only if participant)
      allow delete: if false;

      // ==================== STREAK STATE (server-only) ====================
      // Authoritative streak document: chatRooms/{id}/streak/state.
      // Written exclusively by Cloud Functions through the Admin SDK, which
      // bypasses these rules. Participants may read it; nobody may write it.
      match /streak/{docId} {
        allow read: if request.auth != null
          && request.auth.uid in resource.data.participants;
        allow write: if false;
      }
      
      // ==================== MESSAGES ====================
      match /messages/{messageId} {
        // Helper to check parent chat room participation
        function isChatParticipant() {
          let chatRoom = get(/databases/$(database)/documents/chatRooms/$(chatRoomId));
          return chatRoom != null 
            && chatRoom.data.participants != null
            && request.auth.uid in chatRoom.data.participants;
        }
        
        // Fallback: check if user ID is in the chatRoomId
        function isUserInRoomId() {
          return chatRoomId.matches('.*' + request.auth.uid + '.*');
        }
        
        // Allow reading messages if participant or user is in room ID
        allow read: if request.auth != null && (isChatParticipant() || isUserInRoomId());
        
        // Allow creating message if user is authenticated and is sender
        allow create: if request.auth != null 
          && request.auth.uid == request.resource.data.senderId
          && (isChatParticipant() || isUserInRoomId());
        
        // Allow updating (for read receipts) if participant
        allow update: if request.auth != null 
          && (isChatParticipant() || isUserInRoomId());
        
        // Allow deleting only own messages
        allow delete: if request.auth != null 
          && request.auth.uid == resource.data.senderId;
      }
    }
    
    // ==================== CALLS ====================
    match /calls/{callId} {
      // Only participants can read call data
      allow read: if request.auth != null
        && (resource.data.callerId == request.auth.uid 
            || resource.data.calleeId == request.auth.uid);
      
      // Only the caller or callee can create a call
      allow create: if request.auth != null
        && (request.resource.data.callerId == request.auth.uid 
            || request.resource.data.calleeId == request.auth.uid);
      
      // Only participants can update call status
      allow update: if request.auth != null
        && (resource.data.callerId == request.auth.uid 
            || resource.data.calleeId == request.auth.uid);
      
      // Allow deletion by participants (cleanup after call ends)
      allow delete: if request.auth != null
        && (resource.data.callerId == request.auth.uid
            || resource.data.calleeId == request.auth.uid);

      // E2EE: per-device wrapped Agora encryption keys.
      // Sender writes; recipient reads. Doc id is "<recipientUid>:<deviceId>".
      match /keyEnvelopes/{addr} {
        allow read: if request.auth != null
          && addr.matches(request.auth.uid + ':.*');
        allow create: if request.auth != null
          && (get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid
              || get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid);
      }
    }
    
    // ==================== STATUSES ====================
    match /statuses/{userId} {
      function isValidStatusView(viewerId) {
        return request.auth != null
          && request.auth.uid != userId
          && request.auth.uid == viewerId
          && request.resource.data.keys().hasOnly(['viewerId', 'viewedAt'])
          && request.resource.data.keys().hasAll(['viewerId', 'viewedAt'])
          && request.resource.data.viewerId == viewerId
          && request.resource.data.viewedAt is timestamp;
      }

      // Anyone authenticated can read statuses
      allow read: if request.auth != null;
      
      // Users can create/update their own status document.
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      
      // Users can only delete their own status
      allow delete: if request.auth != null && request.auth.uid == userId;

      match /views/{statusItemId}/viewers/{viewerId} {
        allow read: if request.auth != null
          && (request.auth.uid == userId || request.auth.uid == viewerId);
        allow create, update: if isValidStatusView(viewerId);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // E2EE: wrappedKeys/{statusItemId}/envelopes/{viewerUid:deviceId}
      // Owner writes one envelope per viewer device. Viewer reads only
      // their own. Owner can delete to revoke access.
      match /wrappedKeys/{statusItemId}/envelopes/{addr} {
        allow read: if request.auth != null
          && (addr.matches(request.auth.uid + ':.*')
              || request.auth.uid == userId);
        allow create, update, delete: if request.auth != null
          && request.auth.uid == userId;
      }
    }
    
    // ==================== DEVICE SESSIONS ====================
    // Used by issueDeviceSession / exchangeDeviceSession / revokeDeviceSession
    // Cloud Functions only. Clients must NEVER read or write here directly —
    // tokens are bearer credentials and the Admin SDK enforces all access.
    match /deviceSessions/{tokenHash} {
      allow read, write: if false;
    }

    // ==================== CALL LOGS ====================
    match /callLogs/{logId} {
      // Only participants can read their call logs
      allow read: if request.auth != null 
        && (resource.data.callerId == request.auth.uid 
            || resource.data.calleeId == request.auth.uid);
      
      // Only the caller or callee can create a call log
      allow create: if request.auth != null
        && (request.resource.data.callerId == request.auth.uid 
            || request.resource.data.calleeId == request.auth.uid);
      
      // Prevent updates and deletions
      allow update, delete: if false;
    }

    // ==================== ANONYMOUS MATCHMAKING QUEUE ====================
    match /match_queue/{userId} {
      allow read: if request.auth != null;
      // Users can only create/delete their own queue entries
      allow create: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
      // Matchmaking (findAndPair) requires one user to update the partner's
      // entry. Own user may fully overwrite (re-join); cross-user updates
      // are restricted to only the matchmaking fields.
      allow update: if request.auth != null
        && (request.auth.uid == userId
            || request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'matchedRoomId']));
    }

    // ==================== ANONYMOUS ROOMS ====================
    match /anonymous_rooms/{roomId} {
      function isAnonymousParticipant() {
        return resource.data.user1Id == request.auth.uid
            || resource.data.user2Id == request.auth.uid;
      }

      allow read: if request.auth != null && isAnonymousParticipant();
      // Creator must be one of the room's participants
      allow create: if request.auth != null
        && (request.auth.uid == request.resource.data.user1Id
            || request.auth.uid == request.resource.data.user2Id);
      allow update: if request.auth != null && isAnonymousParticipant();
      allow delete: if false;

      match /messages/{messageId} {
        function isRoomParticipant() {
          let room = get(/databases/$(database)/documents/anonymous_rooms/$(roomId));
          return room.data.user1Id == request.auth.uid
              || room.data.user2Id == request.auth.uid;
        }

        allow read: if request.auth != null && isRoomParticipant();
        // Participants can only send messages as themselves.
        // System-style messages use type:'system' for UI rendering but
        // still carry the real senderId for auditability.
        allow create: if request.auth != null
          && isRoomParticipant()
          && request.auth.uid == request.resource.data.senderId;
        allow update, delete: if false;
      }
    }

    // ==================== USERNAMES (uniqueness reservation) ====================
    // Doc ID is the lowercase handle itself, so Firestore's own create
    // semantics (create fails if the doc already exists) give us an atomic
    // uniqueness guarantee — no other user can ever "win" a race for the
    // same handle. UserService.updateUsername() claims the new handle and
    // releases the old one (if any) inside a single transaction.
    match /usernames/{handle} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      // Handles are immutable once claimed — to change handle, the owner
      // deletes this doc and creates a new one under the new handle.
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // ==================== FRIEND REQUESTS ====================
    match /friend_requests/{requestId} {
      allow read: if request.auth != null
        && (resource.data.fromUserId == request.auth.uid
            || resource.data.toUserId == request.auth.uid);
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.fromUserId;
      // Recipient responds (accept/decline).
      allow update: if request.auth != null
        && resource.data.toUserId == request.auth.uid;
      allow delete: if false;
    }

    // ==================== ANONYMOUS REPORTS ====================
    match /anonymous_reports/{reportId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.reporterUserId;
      allow read, update, delete: if false;
    }
  }
}
