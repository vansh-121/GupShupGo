rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==================== USERS ====================
    match /users/{userId} {
      // Anyone authenticated can read user profiles (for contacts list)
      allow read: if request.auth != null;
      
      // Helper functions to prevent client from writing subscription fields
      // (only server-side Cloud Functions via Admin SDK are allowed to set these)
      function doesNotCreateSubscriptions() {
        return !request.resource.data.keys().hasAny([
          'subscriptionPlan',
          'subscriptionExpiresAt',
          'subscriptionProductId',
          'subscriptionVerifiedAt',
          'subscriptionPurchaseToken'
        ]);
      }

      function doesNotModifySubscriptions() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'subscriptionPlan',
          'subscriptionExpiresAt',
          'subscriptionProductId',
          'subscriptionVerifiedAt',
          'subscriptionPurchaseToken'
        ]);
      }

      // Rewarded-ad payouts. Only the `admobSsv` function may write these, and
      // only after Google's signed callback verified — a client that could set
      // adRestoreCredits itself would make the whole SSV round-trip theatre,
      // since a free Bond Restore is worth real money.
      //
      // adRewardDaily / adRestoreWeekly are the cap counters. They are guarded
      // for the same reason as the balance: resetting a counter is the same
      // exploit as raising the balance, one ad at a time.
      function doesNotTouchAdRewards() {
        return !request.resource.data.keys().hasAny([
          'adRestoreCredits',
          'adRewardDaily',
          'adRestoreWeekly'
        ]);
      }

      function doesNotModifyAdRewards() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'adRestoreCredits',
          'adRewardDaily',
          'adRestoreWeekly'
        ]);
      }

      // Users can only create/update their own profile
      allow create: if request.auth != null && request.auth.uid == userId
        && doesNotCreateSubscriptions()
        && doesNotTouchAdRewards();
      allow update: if request.auth != null && request.auth.uid == userId
        && doesNotModifySubscriptions()
        && doesNotModifyAdRewards();
      
      // Prevent users from deleting profiles
      allow delete: if false;

      // Each signed-in app install stores its own FCM token here. This avoids
      // one device overwriting another and lets Cloud Functions clean up only
      // the stale device token that Firebase rejects.
      //
      // E2EE: this same path also stores the Signal PreKeyBundle (public).
      //   - keyBundle must be readable by ANY authenticated user (otherwise
      //     peers can't initiate a session).
      //   - Only the owner can write/update their own bundle.
      match /devices/{deviceId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;

        // One-time prekeys: readable only by the owner (for the
        // replenishOneTimePreKeysIfLow count check), writable only by the
        // owner. Peers never read these directly — the consumeOneTimePreKey
        // Cloud Function uses the Admin SDK and bypasses rules entirely.
        match /oneTimePreKeys/{preKeyId} {
          allow read: if request.auth != null
            && request.auth.uid == userId;
          allow create, update, delete: if request.auth != null
            && request.auth.uid == userId;
        }
      }

      // E2EE: vault key derivation metadata (Argon2id salt + verifier).
      // Required by VaultCipher.bootstrap on every cold start to decide
      // setup-vs-unlock. Document is owner-only — without it the PIN
      // prompt never appears and the rest of the vault is unreadable.
      match /vaultMeta/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Cross-install message vault: AES-256-GCM ciphertext of decrypted
      // payloads, keyed off the user's vault PIN. Owner-only.
      match /msgVault/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Cross-install status vault: AES-256-GCM ciphertext of decrypted
      // text statuses and AES content keys for media statuses. Owner-only.
      match /statusVault/{statusItemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Friends connection subcollection. Doc path is
      // /users/{userId}/friends/{friendId}.
      //
      // The old rule allowed a write whenever request.auth.uid == friendId,
      // i.e. whenever the DOCUMENT ID matched the caller. That let any
      // authenticated user write /users/{anyVictim}/friends/{theirOwnUid}
      // straight through the SDK and appear in the victim's friends list
      // with no friend request at all, bypassing the entire request flow
      // that streamFriends() renders from.
      //
      // The legitimate cross-user write is exactly one case: accepting a
      // request, where the accepter adds themselves to the requester's list
      // (FriendRequestService.acceptFriendRequest writes both sides in one
      // batch). That is now gated on a real pending request addressed to the
      // caller, so self-insertion into an arbitrary user's list is refused.
      //
      // The authorizing requestId has to travel in the document body:
      // friend_requests ids are auto-generated by .add(), so rules have no
      // other way to locate the request. It is safe to let the client name
      // the id because the request document itself is validated — and
      // friend_requests only permits create when
      // request.auth.uid == fromUserId, so a caller cannot fabricate a
      // request that appears to come from their victim.
      match /friends/{friendId} {
        function invitedByListOwner(requestId) {
          let req = get(/databases/$(database)/documents/friend_requests/$(requestId));
          return req != null
            && req.data.fromUserId == userId
            && req.data.toUserId == request.auth.uid
            && req.data.status == 'pending';
        }

        // Read behaviour is unchanged.
        allow read: if request.auth != null
          && (request.auth.uid == userId || request.auth.uid == friendId);

        // Owners have full control over their own friends list.
        allow write: if request.auth != null && request.auth.uid == userId;

        // Reciprocal insert during accept: self-insertion only, and only
        // when the list owner has a pending request out to the caller.
        allow create, update: if request.auth != null
          && request.auth.uid == friendId
          && request.resource.data.requestId is string
          && invitedByListOwner(request.resource.data.requestId);
      }
    }
    
    // ==================== CHAT ROOMS ====================
    match /chatRooms/{chatRoomId} {
      // Helper function to check if user is participant
      function isParticipant() {
        return resource.data.participants != null 
          && request.auth.uid in resource.data.participants;
      }
      
      function willBeParticipant() {
        return request.resource.data.participants != null
          && request.auth.uid in request.resource.data.participants;
      }
      
      // Helper to check if user ID is in the chatRoomId (fallback for legacy data)
      function isUserInChatRoomId() {
        return chatRoomId.matches('.*' + request.auth.uid + '.*');
      }

      // ---------- Streak (bond) hardening ----------
      // Legacy streak fields still written by old clients on the send path.
      // The authoritative state lives in chatRooms/{id}/streak/state and is
      // written only by Cloud Functions (Admin SDK bypasses these rules).
      function streakLegacyFields() {
        return ['streakCount', 'previousStreakCount', 'lastInteractionDate',
                'lastSentAt', 'streakBrokenAt'];
      }

      function touchesStreak() {
        return request.resource.data.diff(resource.data)
                 .affectedKeys().hasAny(streakLegacyFields());
      }

      // Only the caller's own lastSentAt entry may change, and only to ~now.
      function ownLastSentAtIsFresh() {
        let before = resource.data.get('lastSentAt', {});
        let after = request.resource.data.get('lastSentAt', {});
        let mine = after.get(request.auth.uid, null);
        return after.diff(before).affectedKeys().hasOnly([request.auth.uid])
          && mine is timestamp
          && mine >= request.time - duration.value(5, 'm')
          && mine <= request.time + duration.value(5, 'm');
      }

      // PHASE 1 (dual-write window): legacy streak writes from old clients are
      // tolerated but clamped, so an outdated client cannot forge a streak.
      // A hard deny here would reject the entire message batch those clients
      // send and break message delivery, hence the clamp instead of a deny.
      function legacyStreakWriteIsHarmless() {
        return
          // previousStreakCount is server-only.
          !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['previousStreakCount'])
          // streakBrokenAt may only be cleared, never stamped by a client.
          && (!request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['streakBrokenAt'])
              || request.resource.data.get('streakBrokenAt', null) == null)
          // streakCount may only stay put or advance by exactly one.
          && (!request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['streakCount'])
              || (request.resource.data.get('streakCount', -1) is int
                  && request.resource.data.get('streakCount', -1)
                       >= resource.data.get('streakCount', 0)
                  && request.resource.data.get('streakCount', -1)
                       <= resource.data.get('streakCount', 0) + 1))
          // lastInteractionDate must be within +/- 5 minutes of server time.
          && (!request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['lastInteractionDate'])
              || (request.resource.data.get('lastInteractionDate', null) is timestamp
                  && request.resource.data.get('lastInteractionDate', null)
                       >= request.time - duration.value(5, 'm')
                  && request.resource.data.get('lastInteractionDate', null)
                       <= request.time + duration.value(5, 'm')))
          // lastSentAt: own uid only, within +/- 5 minutes of server time.
          && (!request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['lastSentAt'])
              || ownLastSentAtIsFresh());
      }

      // Allow creating chat room if user is a participant
      allow create: if request.auth != null && willBeParticipant();
      
      // Allow reading if user is a participant OR user ID is in chatRoomId (legacy support)
      allow read: if request.auth != null && (isParticipant() || isUserInChatRoomId());
      
      // Allow updating (for last message, unread count, etc.).
      // isUserInChatRoomId() is deliberately NOT accepted here: a modified
      // client could create a room whose id contains its own uid, which is a
      // forgeable write path. Reads keep it for legacy data compatibility.
      allow update: if request.auth != null
        && isParticipant()
        && (!touchesStreak() || legacyStreakWriteIsHarmless());

      // PHASE 2 (task 10.4, after minimum-version enforcement): hard deny any
      // client write to the legacy streak fields. Replaces the clamp above.
      // allow update: if request.auth != null && isParticipant() && !touchesStreak();

      // Prevent deletion of chat rooms (or allow only if participant)
      allow delete: if false;

      // ==================== STREAK STATE (server-only) ====================
      // Authoritative streak document: chatRooms/{id}/streak/state.
      // Written exclusively by Cloud Functions through the Admin SDK, which
      // bypasses these rules. Participants may read it; nobody may write it.
      match /streak/{docId} {
        allow read: if request.auth != null
          && request.auth.uid in resource.data.participants;
        allow write: if false;
      }
      
      // ==================== MESSAGES ====================
      match /messages/{messageId} {
        // Helper to check parent chat room participation
        function isChatParticipant() {
          let chatRoom = get(/databases/$(database)/documents/chatRooms/$(chatRoomId));
          return chatRoom != null 
            && chatRoom.data.participants != null
            && request.auth.uid in chatRoom.data.participants;
        }
        
        // Fallback: check if user ID is in the chatRoomId
        function isUserInRoomId() {
          return chatRoomId.matches('.*' + request.auth.uid + '.*');
        }
        
        // Allow reading messages if participant or user is in room ID
        allow read: if request.auth != null && (isChatParticipant() || isUserInRoomId());

        // Allow creating message if user is authenticated and is sender
        allow create: if request.auth != null
          && request.auth.uid == request.resource.data.senderId
          && (isChatParticipant() || isUserInRoomId());

        // Fields only a message's own sender may write.
        //
        // "Delete for everyone" and "edit" are both document *updates*, so a
        // participant-wide update rule accepted them from either side: the peer
        // could tombstone your message, or rewrite the plaintext `text` of a
        // legacy v1 one. ChatService re-checks ownership against the server copy
        // before writing, but that check lives in the client it is protecting
        // against, so this is where it has to be true.
        //
        // `senderId` is in the list for a second reason: without it the gate
        // defeats itself. A peer would reassign senderId to their own uid in one
        // write, and satisfy every ownership check below in the next.
        //
        // The 48h limit (ChatService.editWindow) is deliberately NOT enforced
        // here — see the comment on that constant. Bypassing a window is
        // cosmetic; overwriting someone else's message is not.
        //
        // Absent on purpose, because a non-sender must write these:
        //   status        — delivered/read receipts, written by the recipient
        //   deletedFor    — "delete for me", either participant (bounded below)
        //   retryRequests — arrayUnion by the asking device, arrayRemove by the
        //                   sender once it has served the resend
        //   reactions     — no write path today, and when there is one it is the
        //                   recipient's to use
        function touchesSenderOwnedFields() {
          return request.resource.data.diff(resource.data).affectedKeys()
            .hasAny([
              'senderId', 'senderDeviceId', 'receiverId', 'timestamp',
              'deletedForEveryone', 'editedAt',
              'text', 'envelopes', 'mediaUrl', 'type', 'replyToText',
              'linkPreviewUrl', 'linkPreviewTitle', 'linkPreviewDescription',
              'linkPreviewSiteName', 'linkPreviewImageBase64',
              // Reply-quote attribution — without these a peer could forge
              // which message (and whose name) a quote points at.
              'replyToMessageId', 'replyToSenderId', 'replyToSenderName',
              'replyToType',
              // Status-reply context — same rationale: only the sender who
              // composed the status-reply should be able to set/change it.
              'statusReplyOwnerId', 'statusReplyItemId',
              'statusReplyOwnerName', 'statusReplyOwnerPhotoUrl',
              'statusReplyType', 'statusReplyText',
              'statusReplyMediaUrl', 'statusReplyCaption',
              'statusReplyBackgroundColor',
            ]);
        }

        // "Delete for me" hides a message from one participant, so a participant
        // may only ever add or remove *themselves* — never the other side's
        // entry, which would hide a message from them, or un-hide one they had
        // hidden. The client only ever writes arrayUnion([own uid]).
        //
        // Phrased as two subset checks rather than the more obvious
        // "diff the lists": `removeAll` and `Set.difference` both fault on an
        // *empty argument*, so a write that empties the array — the last entry
        // removed — would be denied by an evaluation error instead of by the
        // rule. Both arguments here contain the caller's own uid, so neither can
        // ever be empty.
        function deletedForOnlyAffectsSelf() {
          let self = [request.auth.uid];
          let before = resource.data.get('deletedFor', []);
          let after = request.resource.data.get('deletedFor', []);
          // after ⊆ before ∪ {self}: the only entry you can add is your own.
          return after.hasOnly(before.concat(self))
            // before ⊆ after ∪ {self}: the only entry you can drop is your own.
            && before.hasOnly(after.concat(self));
        }

        // Allow updating (read receipts, "delete for me", resend requests) if
        // participant. Sender-owned fields additionally require ownership.
        allow update: if request.auth != null
          && (isChatParticipant() || isUserInRoomId())
          && (!touchesSenderOwnedFields()
              || request.auth.uid == resource.data.senderId)
          && (!request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['deletedFor'])
              || deletedForOnlyAffectsSelf());

        // Allow deleting only own messages
        allow delete: if request.auth != null 
          && request.auth.uid == resource.data.senderId;
      }
    }
    
    // ==================== CALLS ====================
    match /calls/{callId} {
      // Only participants can read call data
      allow read: if request.auth != null
        && (resource.data.callerId == request.auth.uid 
            || resource.data.calleeId == request.auth.uid);
      
      // Only the caller or callee can create a call
      allow create: if request.auth != null
        && (request.resource.data.callerId == request.auth.uid 
            || request.resource.data.calleeId == request.auth.uid);
      
      // Only participants can update call status
      allow update: if request.auth != null
        && (resource.data.callerId == request.auth.uid 
            || resource.data.calleeId == request.auth.uid);
      
      // Allow deletion by participants (cleanup after call ends)
      allow delete: if request.auth != null
        && (resource.data.callerId == request.auth.uid
            || resource.data.calleeId == request.auth.uid);

      // E2EE: per-device wrapped Agora encryption keys.
      // Sender writes; recipient reads. Doc id is "<recipientUid>:<deviceId>".
      match /keyEnvelopes/{addr} {
        allow read: if request.auth != null
          && addr.matches(request.auth.uid + ':.*');
        allow create: if request.auth != null
          && (get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid
              || get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid);
      }
    }
    
    // ==================== STATUSES ====================
    match /statuses/{userId} {
      function isValidStatusView(viewerId) {
        return request.auth != null
          && request.auth.uid != userId
          && request.auth.uid == viewerId
          && request.resource.data.keys().hasOnly(['viewerId', 'viewedAt'])
          && request.resource.data.keys().hasAll(['viewerId', 'viewedAt'])
          && request.resource.data.viewerId == viewerId
          && request.resource.data.viewedAt is timestamp;
      }

      // Anyone authenticated can read statuses
      allow read: if request.auth != null;
      
      // Users can create/update their own status document.
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      
      // Users can only delete their own status
      allow delete: if request.auth != null && request.auth.uid == userId;

      match /views/{statusItemId}/viewers/{viewerId} {
        allow read: if request.auth != null
          && (request.auth.uid == userId || request.auth.uid == viewerId);
        allow create, update: if isValidStatusView(viewerId);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // E2EE: wrappedKeys/{statusItemId}/envelopes/{viewerUid:deviceId}
      // Owner writes one envelope per viewer device. Viewer reads only
      // their own. Owner can delete to revoke access.
      match /wrappedKeys/{statusItemId}/envelopes/{addr} {
        allow read: if request.auth != null
          && (addr.matches(request.auth.uid + ':.*')
              || request.auth.uid == userId);
        allow create, update, delete: if request.auth != null
          && request.auth.uid == userId;
      }
    }
    
    // ==================== DEVICE SESSIONS ====================
    // Used by issueDeviceSession / exchangeDeviceSession / revokeDeviceSession
    // Cloud Functions only. Clients must NEVER read or write here directly —
    // tokens are bearer credentials and the Admin SDK enforces all access.
    match /deviceSessions/{tokenHash} {
      allow read, write: if false;
    }

    // ==================== AD REWARDS (SSV ledger) ====================
    // One doc per AdMob `transaction_id`, written only by the `admobSsv` function
    // inside the transaction that credits the reward. Its existence IS the replay
    // guard: a client able to delete a row here could re-claim a reward Google
    // already paid, so nothing outside the Admin SDK gets any access at all.
    match /adRewards/{transactionId} {
      allow read, write: if false;
    }

    // ==================== CALL LOGS ====================
    match /callLogs/{logId} {
      // Only participants can read their call logs
      allow read: if request.auth != null 
        && (resource.data.callerId == request.auth.uid 
            || resource.data.calleeId == request.auth.uid);
      
      // Only the caller or callee can create a call log
      allow create: if request.auth != null
        && (request.resource.data.callerId == request.auth.uid 
            || request.resource.data.calleeId == request.auth.uid);
      
      // Prevent updates and deletions
      allow update, delete: if false;
    }

    // ==================== RESEND WAKEUPS ====================
    // Write-only signal that fires the notifyResendRequest Cloud Function, which
    // sends the message's sender a silent data push so their app can answer an
    // E2EE resend request even when it isn't running. Only the sender's own
    // device holds the plaintext, so no server-side repair is possible — waking
    // them is the whole mechanism.
    //
    // Not a trigger on the message document itself: those are updated on every
    // read receipt and delivery tick, so a Function watching them would be
    // invoked several times per message and do nothing almost every time.
    match /resendWakeups/{wakeupId} {
      // Nothing ever reads these back. The Function consumes them with the Admin
      // SDK, which bypasses rules entirely.
      allow read, update, delete: if false;

      // Bind the wakeup to a real message that `senderId` actually wrote and to
      // the specific retry request it claims to be accelerating.
      //
      // Room participation alone is not a sufficient bound. A participant could
      // otherwise mint unlimited wakeups for invented messageIds and use the
      // Function as a silent-push amplifier against someone they share a chat
      // with — worse than the message spam that is the only comparable thing a
      // participant can already do, because these pushes leave no tray entry,
      // no bubble and no unread count, and each one wakes the peer's process to
      // do Signal work.
      //
      // Nor is "some request is pending" sufficient, which is what this checked
      // first. That bounded which messages were wakeable but nothing else: the
      // document id also contains `deviceId`, which no rule constrained beyond
      // being positive, so walking it produced an unlimited supply of distinct
      // ids that each passed. Matching the *exact* tag closes that, because it
      // makes every field in the id answerable to something already on the
      // message document.
      //
      // `_requestResend` writes the tag and awaits it before writing this doc, so
      // the match holds on every legitimate call. A sender fast enough to serve
      // and `arrayRemove` the tag first will deny the wakeup, which is correct —
      // there is nothing left to accelerate.
      function retryTag() {
        // The wire format from `_requestResend`: `<uid>:<deviceId>#<attempt>`.
        return request.auth.uid + ':'
          + string(request.resource.data.deviceId) + '#'
          + string(request.resource.data.attempt);
      }

      function awaitingResend(roomId, messageId, senderId) {
        let m = get(/databases/$(database)/documents/chatRooms/$(roomId)/messages/$(messageId)).data;
        return m.senderId == senderId
          && m.get('retryRequests', []).hasAny([retryTag()]);
      }

      // The document id, derived entirely from fields this rule has already
      // validated. Nothing here can be forged: `roomId`, `messageId` and the
      // caller's uid are each checked below, so the id is fully determined.
      function expectedId() {
        return request.resource.data.roomId + '_'
          + request.resource.data.messageId + '_'
          + request.auth.uid + '_'
          + string(request.resource.data.deviceId) + '_'
          + string(request.resource.data.attempt);
      }

      allow create: if request.auth != null
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.senderId is string
        && request.resource.data.senderId != request.auth.uid
        && request.resource.data.roomId is string
        && request.resource.data.messageId is string
        // Server-stamped, so the Function's five-minute staleness drop is a real
        // gate and not one the client opts out of by omitting the field.
        && request.resource.data.at == request.time
        // ── The write-once ceiling ──────────────────────────────────────────
        //
        // An auto-id let a client re-create a wakeup for the same request as fast
        // as it could write — every one of them authorized, every one another
        // high-priority push and another Function invocation. Pinning the id to
        // (message, requester device, attempt) turns that into a create-once: the
        // second write to a live id is an update, and updates are denied above.
        // `notifyResendRequest` deliberately no longer deletes these documents,
        // because deleting one would hand the id straight back.
        //
        // The id is only a ceiling because every field in it is pinned to
        // something else. `deviceId` and `attempt` are free-form ints, so on their
        // own they are a way to walk the id space rather than a bound on it — the
        // `hasAny` check in `awaitingResend` is what ties both to a tag the client
        // had to write onto the message document first. The checks here just keep
        // the pairing honest: `is int` so `string()` renders the same value the
        // tag does, and positivity because no real device or attempt is zero.
        //
        // `attempt <= 20` is a sanity bound rather than the rate limit — the
        // protocol's own lifetime cap is 15. Denying an over-cap write costs only
        // the accelerator; the request is already on the message document, which
        // is what actually drives the repair.
        && request.resource.data.deviceId is int
        && request.resource.data.deviceId > 0
        && request.resource.data.attempt is int
        && request.resource.data.attempt > 0
        && request.resource.data.attempt <= 20
        && wakeupId == expectedId()
        // Both uids must be participants of the named room. Requiring it of
        // `senderId` too — not just the caller — is what stops this being a
        // "deliver a silent push to any uid" primitive: you can only wake
        // someone you already share a chat with, which sending them a message
        // does anyway.
        && get(/databases/$(database)/documents/chatRooms/$(request.resource.data.roomId))
             .data.participants.hasAll([request.auth.uid,
                                        request.resource.data.senderId])
        && awaitingResend(request.resource.data.roomId,
                          request.resource.data.messageId,
                          request.resource.data.senderId);
    }

    // ==================== ANONYMOUS MATCHMAKING QUEUE ====================
    match /match_queue/{userId} {
      allow read: if request.auth != null;
      // Users can only create/delete their own queue entries
      allow create: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
      // Matchmaking (findAndPair) requires one user to update the partner's
      // entry. Own user may fully overwrite (re-join); cross-user updates
      // are restricted to only the matchmaking fields.
      allow update: if request.auth != null
        && (request.auth.uid == userId
            || request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'matchedRoomId']));
    }

    // ==================== ANONYMOUS ROOMS ====================
    match /anonymous_rooms/{roomId} {
      function isAnonymousParticipant() {
        return resource.data.user1Id == request.auth.uid
            || resource.data.user2Id == request.auth.uid;
      }

      allow read: if request.auth != null && isAnonymousParticipant();
      // Creator must be one of the room's participants
      allow create: if request.auth != null
        && (request.auth.uid == request.resource.data.user1Id
            || request.auth.uid == request.resource.data.user2Id);
      allow update: if request.auth != null && isAnonymousParticipant();
      allow delete: if false;

      match /messages/{messageId} {
        function isRoomParticipant() {
          let room = get(/databases/$(database)/documents/anonymous_rooms/$(roomId));
          return room.data.user1Id == request.auth.uid
              || room.data.user2Id == request.auth.uid;
        }

        allow read: if request.auth != null && isRoomParticipant();
        // Participants can only send messages as themselves.
        // System-style messages use type:'system' for UI rendering but
        // still carry the real senderId for auditability.
        allow create: if request.auth != null
          && isRoomParticipant()
          && request.auth.uid == request.resource.data.senderId;
        allow update, delete: if false;
      }
    }

    // ==================== USERNAMES (uniqueness reservation) ====================
    // Doc ID is the lowercase handle itself, so Firestore's own create
    // semantics (create fails if the doc already exists) give us an atomic
    // uniqueness guarantee — no other user can ever "win" a race for the
    // same handle. UserService.updateUsername() claims the new handle and
    // releases the old one (if any) inside a single transaction.
    match /usernames/{handle} {
      allow read: if request.auth != null;

      // The handle format is enforced here as well as on the client.
      // `^[a-z0-9_]{3,20}$` mirrors the check in
      // username_setup_screen.dart and UserService.updateUsername.
      //
      // Without it the rule validated only the `uid` field and ignored the
      // document ID entirely, so a client calling the SDK directly could
      // reserve arbitrary ids — handles with spaces, punctuation or emoji,
      // or 1-character handles — permanently polluting this collection,
      // since a claimed slot can only be released by its owner.
      //
      // Scope note: this does NOT stop handle squatting. Reserving a
      // *validly formatted* handle you never intend to use is still allowed
      // by `uid == request.auth.uid`, because a reservation is deliberately
      // decoupled from the user's actual `username` field. Preventing that
      // needs a Cloud Function that claims the handle and sets the profile
      // field in one Admin-SDK write.
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && handle.matches('^[a-z0-9_]{3,20}$');

      // Handles are immutable once claimed — to change handle, the owner
      // deletes this doc and creates a new one under the new handle.
      // Delete is intentionally NOT format-gated, so an owner can still
      // release a legacy handle that predates this rule.
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // ==================== FRIEND REQUESTS ====================
    match /friend_requests/{requestId} {
      allow read: if request.auth != null
        && (resource.data.fromUserId == request.auth.uid
            || resource.data.toUserId == request.auth.uid);
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.fromUserId;
      // Recipient responds (accept/decline).
      allow update: if request.auth != null
        && resource.data.toUserId == request.auth.uid;
      allow delete: if false;
    }

    // ==================== ANONYMOUS REPORTS ====================
    match /anonymous_reports/{reportId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.reporterUserId;
      allow read, update, delete: if false;
    }

    // ==================== PROBLEM REPORTS ====================
    // Users can submit bug reports from the app settings. Only the
    // owning user can create; reads/updates are admin-only (Cloud
    // Functions mark emailSent after dispatching the notification).
    //
    // Each created doc triggers a support email (processProblemReportEmail),
    // so the payload is tightly validated here as defence-in-depth: exact
    // field set, correct types, and capped string lengths so a malicious
    // client can't write oversized docs or inject extra fields. Per-user
    // volume/rate limiting lives in the Cloud Function.
    match /problem_reports/{reportId} {
      function isValidProblemReport() {
        let data = request.resource.data;
        return data.keys().hasOnly([
              'userId', 'userName', 'userEmail', 'subject',
              'body', 'platform', 'createdAt', 'emailSent'
            ])
          && data.userId is string
          && data.userName is string && data.userName.size() <= 100
          && data.userEmail is string && data.userEmail.size() <= 200
          && data.subject is string
            && data.subject.size() >= 1 && data.subject.size() <= 200
          && data.body is string
            && data.body.size() >= 1 && data.body.size() <= 5000
          && data.platform is string && data.platform.size() <= 50
          && data.emailSent == false
          && data.createdAt == request.time;
      }

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId
        && isValidProblemReport();
      allow read, update, delete: if false;
    }

    // Server-only sliding-window counters backing the problem-report email
    // rate limit (written by the processProblemReportEmail Cloud Function via
    // the Admin SDK, which bypasses these rules). No client access.
    match /problem_report_limits/{userId} {
      allow read, write: if false;
    }
  }
}
