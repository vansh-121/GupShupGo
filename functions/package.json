{
  "name": "gupshupgo-functions",
  "description": "Cloud Functions for GupShupGo FCM notifications",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "npm run test:unit && npm run test:rules",
    "test:unit": "mocha test/*.unit.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project gsg-rules-test \"mocha --timeout 20000 test/*_rules.test.js\""
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "agora-token": "^2.0.5",
    "firebase-admin": "^13.8.0",
    "firebase-functions": "^7.2.5",
    "googleapis": "^144.0.0",
    "nodemailer": "^6.10.1"
  },
  "private": true,
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0",
    "firebase-functions-test": "^3.4.1",
    "mocha": "^10.8.2"
  }
}
